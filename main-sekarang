<script>

/* =========================================================
   PENGATURAN UTAMA
   ========================================================= */

const CONFIG = {

  profile: {

    name: "SLOT GACOR",

    username: "@benihtoto_gacor",

    coverTitle: "VIDEO TERBARU • BLUEPLAY",

    coverImage:
      "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1920&q=90",

    profileImage:
      "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=500&q=90"

  },


  links: {

    menuPanjang:
      "https://example.com",

    daftar:
      "https://example.com/daftar",

    login:
      "https://example.com/login",

    promosi:
      "https://example.com/promosi",

    event:
      "https://example.com/event",

    telegram:
      "https://t.me/",

    livechat:
      "https://example.com/livechat"

  },


  /* =======================================================
     VIDEO
     
     POSTER SUDAH DIHAPUS
     ======================================================= */

  videos: [

    {

      game: "GAME 01 • POLA TERBARU",

      video:
        "https://www.image2url.com/r2/default/videos/1786694627950-68a2f532-638d-4209-9506-c330718ec062.mp4",

      playUrl:
        "https://example.com/game-01",

      startViews: 1284

    },


    {

      game: "GAME 02 • PREDIKSI",

      video:
        "https://www.image2url.com/r2/default/videos/1786694627950-68a2f532-638d-4209-9506-c330718ec062.mp4",

      playUrl:
        "https://example.com/game-02",

      startViews: 863

    },


    {

      game: "GAME 03 • SCATTER",

      video:
        "https://www.image2url.com/r2/default/videos/1786694627950-68a2f532-638d-4209-9506-c330718ec062.mp4",

      playUrl:
        "https://capital4.benihtotopro.one/",

      startViews: 2147

    }

  ]

};


/* =========================================================
   SISTEM HALAMAN
   ========================================================= */

const $ = (id) =>
  document.getElementById(id);


/* PROFILE */

$("coverImage").src =
  CONFIG.profile.coverImage;

$("profileImage").src =
  CONFIG.profile.profileImage;

$("profileName").textContent =
  CONFIG.profile.name;

$("profileUsername").textContent =
  CONFIG.profile.username;

$("coverTitle").textContent =
  CONFIG.profile.coverTitle;


/* LINKS */

$("longMenu").href =
  CONFIG.links.menuPanjang;

$("registerBtn").href =
  CONFIG.links.daftar;

$("loginBtn").href =
  CONFIG.links.login;

$("navPromosi").href =
  CONFIG.links.promosi;

$("navEvent").href =
  CONFIG.links.event;

$("navTelegram").href =
  CONFIG.links.telegram;


/* VIDEO */

const grid =
  $("videoGrid");

const videoElements =
  [];

const videoCards =
  [];


/* FORMAT VIEW */

function formatViews(n){

  return new Intl.NumberFormat(
    "id-ID",
    {
      notation:"compact",
      maximumFractionDigits:1
    }
  ).format(n);

}


/* FORMAT DURASI */

function formatTime(seconds){

  if(!Number.isFinite(seconds))
    return "0:00";

  const minutes =
    Math.floor(seconds / 60);

  const secs =
    Math.floor(seconds % 60)
      .toString()
      .padStart(2,"0");

  return `${minutes}:${secs}`;

}


/* =========================================================
   MATIKAN SEMUA VIDEO LAIN
   ========================================================= */

function pauseOtherVideos(currentIndex){

  videoElements.forEach(
    (other,index) => {

      if(index !== currentIndex){

        other.pause();

        const card =
          videoCards[index];

        const btn =
          card.querySelector(".play-btn");

        card.classList.remove("playing");

        card.classList.add("paused");

        btn.classList.remove("hidden");

      }

    }
  );

}


/* =========================================================
   BUAT VIDEO
   ========================================================= */

CONFIG.videos.forEach(
  (item,index) => {


    const card =
      document.createElement("article");

    card.className =
      "video-card";


    card.innerHTML = `

      <div class="video-wrap">

        <video
          preload="metadata"
          playsinline
          webkit-playsinline
          src="${item.video}"
        ></video>


        <!-- PLAY TRANSPARAN -->

        <button
          class="play-btn"
          type="button"
          aria-label="Putar ${item.game}"
        >

          <span class="play-icon"></span>

        </button>


        <!-- PAUSE INDICATOR -->

        <div class="pause-indicator">

          <div class="pause-bars">

            <span></span>
            <span></span>

          </div>

        </div>


        <!-- GAME -->

        <div class="game-tag">
          ${item.game}
        </div>


        <!-- VIEWS -->

        <div class="views">

          <span class="live-dot"></span>

          <span class="view-number">
            ${formatViews(item.startViews)}
          </span>

        </div>


        <!-- VIDEO CONTROLS -->

        <div class="video-controls">

          <div class="progress-wrap">

            <input
              class="progress"
              type="range"
              min="0"
              max="100"
              value="0"
              step="0.1"
              aria-label="Progress video"
            />

          </div>


          <div class="control-row">

            <div class="control-left">

              <button
                class="control-btn mini-play"
                type="button"
                aria-label="Play atau pause"
              >
                ▶
              </button>


              <span class="time-display">
                0:00 / 0:00
              </span>

            </div>


            <div class="control-right">

              <select
                class="speed-select"
                aria-label="Kecepatan video"
              >

                <option value="0.5">
                  0.5x
                </option>

                <option value="0.75">
                  0.75x
                </option>

                <option
                  value="1"
                  selected
                >
                  1x
                </option>

                <option value="1.25">
                  1.25x
                </option>

                <option value="1.5">
                  1.5x
                </option>

                <option value="2">
                  2x
                </option>

              </select>


              <button
                class="control-btn mute-btn"
                type="button"
                aria-label="Mute"
              >
                🔊
              </button>


              <button
                class="control-btn fullscreen-btn"
                type="button"
                aria-label="Fullscreen"
              >
                ⛶
              </button>

            </div>

          </div>

        </div>

      </div>


      <!-- BUTTON MAINKAN -->

      <div class="play-area">

        <a
          class="play-link"
          href="${item.playUrl}"
          target="_blank"
          rel="noopener"
        >
          ▶ MAINKAN
        </a>

      </div>

    `;


    grid.appendChild(card);


    /* ELEMENT VIDEO */

    const video =
      card.querySelector("video");

    const playBtn =
      card.querySelector(".play-btn");

    const miniPlay =
      card.querySelector(".mini-play");

    const progress =
      card.querySelector(".progress");

    const timeDisplay =
      card.querySelector(".time-display");

    const speedSelect =
      card.querySelector(".speed-select");

    const muteBtn =
      card.querySelector(".mute-btn");

    const fullscreenBtn =
      card.querySelector(".fullscreen-btn");

    const pauseIndicator =
      card.querySelector(".pause-indicator");

    const videoWrap =
      card.querySelector(".video-wrap");

    const viewNumber =
      card.querySelector(".view-number");


    videoElements.push(video);

    videoCards.push(card);


    let views =
      item.startViews;

    let hasCountedView =
      false;


    /* =====================================================
       PLAY BUTTON
       ===================================================== */

    async function playVideo(){

      pauseOtherVideos(index);


      try{

        await video.play();

        card.classList.add("playing");

        card.classList.remove("paused");

        playBtn.classList.add("hidden");

        miniPlay.textContent =
          "❚❚";


        if(!hasCountedView){

          views++;

          viewNumber.textContent =
            formatViews(views);

          hasCountedView =
            true;

        }

      }catch(err){

        showToast(
          "Video belum bisa diputar. Pastikan link MP4 dapat diakses."
        );

      }

    }


    /* =====================================================
       PAUSE VIDEO
       ===================================================== */

    function pauseVideo(){

      video.pause();

      card.classList.remove("playing");

      card.classList.add("paused");

      playBtn.classList.remove("hidden");

      miniPlay.textContent =
        "▶";

    }


    /* =====================================================
       PLAY BUTTON UTAMA
       ===================================================== */

    playBtn.addEventListener(
      "click",
      async (e) => {

        e.stopPropagation();

        if(video.paused){

          await playVideo();

        }else{

          pauseVideo();

        }

      }
    );


    /* =====================================================
       KLIK VIDEO = PLAY / PAUSE
       ===================================================== */

    video.addEventListener(
      "click",
      async () => {

        if(video.paused){

          await playVideo();

        }else{

          pauseVideo();

          pauseIndicator.classList.remove("show");

          void pauseIndicator.offsetWidth;

          pauseIndicator.classList.add("show");

        }

      }
    );


    /* =====================================================
       MINI PLAY / PAUSE
       ===================================================== */

    miniPlay.addEventListener(
      "click",
      async (e) => {

        e.stopPropagation();

        if(video.paused){

          await playVideo();

        }else{

          pauseVideo();

        }

      }
    );


    /* =====================================================
       VIDEO PLAY EVENT
       ===================================================== */

    video.addEventListener(
      "play",
      () => {

        pauseOtherVideos(index);

        card.classList.add("playing");

        card.classList.remove("paused");

        playBtn.classList.add("hidden");

        miniPlay.textContent =
          "❚❚";

      }
    );


    /* =====================================================
       VIDEO PAUSE EVENT
       ===================================================== */

    video.addEventListener(
      "pause",
      () => {

        card.classList.remove("playing");

        card.classList.add("paused");

        playBtn.classList.remove("hidden");

        miniPlay.textContent =
          "▶";

      }
    );


    /* =====================================================
       VIDEO SELESAI
       ===================================================== */

    video.addEventListener(
      "ended",
      () => {

        card.classList.remove("playing");

        card.classList.add("paused");

        playBtn.classList.remove("hidden");

        miniPlay.textContent =
          "▶";

        progress.value =
          0;

      }
    );


    /* =====================================================
       DURASI VIDEO
       ===================================================== */

    video.addEventListener(
      "loadedmetadata",
      () => {

        timeDisplay.textContent =
          `0:00 / ${formatTime(video.duration)}`;

      }
    );


    /* =====================================================
       UPDATE PROGRESS
       ===================================================== */

    video.addEventListener(
      "timeupdate",
      () => {

        if(video.duration){

          const percent =
            (video.currentTime / video.duration) * 100;

          progress.value =
            percent;

        }

        timeDisplay.textContent =
          `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;

      }
    );


    /* =====================================================
       SEEK / LONCAT DURASI
       ===================================================== */

    progress.addEventListener(
      "input",
      () => {

        if(video.duration){

          video.currentTime =
            (progress.value / 100) *
            video.duration;

        }

      }
    );


    /* =====================================================
       SPEED CONTROL
       ===================================================== */

    speedSelect.addEventListener(
      "change",
      () => {

        video.playbackRate =
          parseFloat(speedSelect.value);

        showToast(
          `Kecepatan video ${speedSelect.value}x`
        );

      }
    );


    /* =====================================================
       MUTE
       ===================================================== */

    muteBtn.addEventListener(
      "click",
      (e) => {

        e.stopPropagation();

        video.muted =
          !video.muted;

        muteBtn.textContent =
          video.muted
            ? "🔇"
            : "🔊";

      }
    );


    /* =====================================================
       FULLSCREEN
       ===================================================== */

    fullscreenBtn.addEventListener(
      "click",
      async (e) => {

        e.stopPropagation();

        try{

          if(document.fullscreenElement){

            await document.exitFullscreen();

          }else if(videoWrap.requestFullscreen){

            await videoWrap.requestFullscreen();

          }else if(video.webkitEnterFullscreen){

            video.webkitEnterFullscreen();

          }

        }catch(err){

          showToast(
            "Fullscreen tidak tersedia di browser ini."
          );

        }

      }
    );


    /* =====================================================
       TAP VIDEO UNTUK MEMUNCULKAN CONTROLS
       ===================================================== */

    videoWrap.addEventListener(
      "click",
      (e) => {

        if(
          e.target.closest(".video-controls") ||
          e.target.closest(".play-btn")
        ){

          return;

        }

        videoWrap.classList.add(
          "controls-visible"
        );

        clearTimeout(
          videoWrap.controlsTimer
        );

        videoWrap.controlsTimer =
          setTimeout(
            () => {

              videoWrap.classList.remove(
                "controls-visible"
              );

            },
            3000
          );

      }
    );


    /* =====================================================
       AUTO HIDE CONTROLS
       ===================================================== */

    video.addEventListener(
      "play",
      () => {

        videoWrap.classList.add(
          "controls-visible"
        );

        clearTimeout(
          videoWrap.controlsTimer
        );

        videoWrap.controlsTimer =
          setTimeout(
            () => {

              videoWrap.classList.remove(
                "controls-visible"
              );

            },
            3000
          );

      }
    );


  }
);


/* =========================================================
   LIVECHAT
   ========================================================= */

$("navLivechat").addEventListener(
  "click",
  (e) => {

    e.preventDefault();

    $("modalTitle").textContent =
      "LIVECHAT";

    $("modalText").textContent =
      "Klik tombol di bawah untuk membuka Livechat. Link dapat Anda ganti di CONFIG.links.livechat.";

    $("modalAction").href =
      CONFIG.links.livechat;

    $("modal").classList.add(
      "show"
    );

  }
);


$("closeModal").addEventListener(
  "click",
  () =>
    $("modal").classList.remove(
      "show"
    )
);


$("modal").addEventListener(
  "click",
  (e) => {

    if(e.target === $("modal")){

      $("modal").classList.remove(
        "show"
      );

    }

  }
);


/* =========================================================
   SHARE
   ========================================================= */

$("shareBtn").addEventListener(
  "click",
  async () => {

    try{

      if(navigator.share){

        await navigator.share({

          title:
            CONFIG.profile.name,

          text:
            "Lihat profil dan video terbaru.",

          url:
            location.href

        });

      }else{

        await navigator.clipboard.writeText(
          location.href
        );

        showToast(
          "Link halaman berhasil disalin."
        );

      }

    }catch(e){}

  }
);


/* =========================================================
   MENU TITIK TIGA
   ========================================================= */

$("moreBtn").addEventListener(
  "click",
  () => {

    showToast(
      "Semua menu link dapat Anda ubah di bagian CONFIG pada file HTML."
    );

  }
);


/* =========================================================
   ANIMASI ANGKA PENONTON ONLINE
   ========================================================= */

let online =
  7;


setInterval(
  () => {

    online +=
      Math.random() > .5
        ? 1
        : -1;

    online =
      Math.max(
        3,
        Math.min(
          18,
          online
        )
      );

    document.title =
      `${online} orang sedang melihat • ${CONFIG.profile.name}`;

  },
  4200
);


/* =========================================================
   TOAST
   ========================================================= */

function showToast(text){

  const toast =
    $("toast");

  toast.textContent =
    text;

  toast.classList.add(
    "show"
  );

  clearTimeout(
    window.toastTimer
  );

  window.toastTimer =
    setTimeout(
      () => {

        toast.classList.remove(
          "show"
        );

      },
      2600
    );

}

</script>

